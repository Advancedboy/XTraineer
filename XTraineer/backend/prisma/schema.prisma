
datasource db {
  provider = "sqlite"
  url      = "file:./db/dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// ----------------------
// ENUMS
// ----------------------
enum Role {
  USER
  ADMIN
}

enum SportTypeEnum {
  GYM
  MMA
  ATHLETICS
}

// ----------------------
// MODELS
// ----------------------

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  age       Int?
  height    Int?
  weight    Int?
  gender    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  profile           UserProfile?
  workoutPlans      WorkoutPlan[]
  completedWorkouts CompletedWorkout[]
  recommendations   Recommendation[]
}

model UserProfile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique
  user   User    @relation(fields: [userId], references: [id])
}

model SportType {
  id           Int           @id @default(autoincrement())
  name         SportTypeEnum @unique
  workoutPlans WorkoutPlan[]
}

model WorkoutPlan {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean @default(false)

  sportTypeId Int
  sportType   SportType @relation(fields: [sportTypeId], references: [id])

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  exercises WorkoutExercise[]
  completed CompletedWorkout[]
}

model WorkoutExercise {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  reps        Int?
  sets        Int?
  duration    Int? // время в секундах
  planId      Int
  plan        WorkoutPlan @relation(fields: [planId], references: [id])

  results WorkoutResult[]
}

model CompletedWorkout {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  planId Int?
  plan   WorkoutPlan? @relation(fields: [planId], references: [id])

  startedAt  DateTime
  finishedAt DateTime?
  notes      String?

  results WorkoutResult[]
}

model WorkoutResult {
  id                 Int              @id @default(autoincrement())
  completedWorkoutId Int
  completedWorkout   CompletedWorkout @relation(fields: [completedWorkoutId], references: [id])

  exerciseId Int
  exercise   WorkoutExercise @relation(fields: [exerciseId], references: [id])

  weight   Int?
  reps     Int?
  sets     Int?
  duration Int? // время в секундах
}

model Recommendation {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  content    String
  reason     String?
  sourceRule String?
  createdAt  DateTime @default(now())
}
