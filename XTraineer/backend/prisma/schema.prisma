datasource db {
  provider = "sqlite"
  url      = "file:./db/dev.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  age       Int?
  height    Float?
  weight    Float?
  gender    String?
  createdAt DateTime @default(now())

  profile           UserProfile?
  workoutPlans      WorkoutPlan[]
  completedWorkouts CompletedWorkout[]
  recommendations   Recommendation[]
}

model UserProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  goals     String?
  avatarUrl String?
}

model SportType {
  id           Int           @id @default(autoincrement())
  key          String        @unique
  name         String
  description  String?
  workoutPlans WorkoutPlan[]
}

model WorkoutPlan {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  isPublic    Boolean @default(false)

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  sportTypeId       Int
  sportType         SportType          @relation(fields: [sportTypeId], references: [id])
  completedWorkouts CompletedWorkout[]

  exercises WorkoutExercise[]
  createdAt DateTime          @default(now())
}

model WorkoutExercise {
  id     Int         @id @default(autoincrement())
  planId Int
  plan   WorkoutPlan @relation(fields: [planId], references: [id])

  name              String
  description       String?
  order             Int?
  sets              Int?
  reps              Int?
  targetWeightKg    Float?
  targetDurationSec Int?
}

model CompletedWorkout {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  planId Int?
  plan   WorkoutPlan? @relation(fields: [planId], references: [id])

  startedAt  DateTime
  finishedAt DateTime?
  notes      String?

  results   WorkoutResult[]
  createdAt DateTime        @default(now())
}

model WorkoutResult {
  id                 Int              @id @default(autoincrement())
  completedWorkoutId Int
  completedWorkout   CompletedWorkout @relation(fields: [completedWorkoutId], references: [id])

  exerciseName String
  setsDone     Int?
  repsPerSet   Int?
  weightKg     Float?
  durationSec  Int?
  notes        String?
}

model Recommendation {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  content    String
  reason     String?
  sourceRule String?

  createdAt DateTime @default(now())
}
